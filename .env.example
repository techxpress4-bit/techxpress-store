# Copiez ce fichier en .env.local et remplissez les valeurs

# Sanity — Dashboard: https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=votre-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=votre-token-avec-write-permission

# Resend — Dashboard: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxx
RESEND_TO_EMAIL=commandes@votredomaine.com

# WhatsApp (format international sans +)
NEXT_PUBLIC_WHATSAPP_NUMBER=213XXXXXXXXX

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Sanity webhook revalidation (génère une chaîne aléatoire longue)
SANITY_REVALIDATE_SECRET=un-secret-long-et-aleatoire
